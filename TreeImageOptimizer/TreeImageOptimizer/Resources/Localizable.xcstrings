    },
    "c.help.scale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Larger scaling slows processing and increases file size."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大する程処理速度が低下し、ファイルサイズが大きくなります。"
