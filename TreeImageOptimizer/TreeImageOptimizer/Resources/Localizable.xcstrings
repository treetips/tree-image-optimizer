    "s.help.bgcolor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallpaper maintains its aspect ratio, so margins may appear. The margin color is the background color."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景画像は縦横比を維持するため、余白できることがあります。その余白部分の色が背景色になります。"
          }
        }
      }
    },
    "s.help.errorSound": {
      "extractionState": "manual",
      "localizations": {
