    },
    "c.help.outputFolder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a file with the same name already exists at the output destination, it will be overwritten and copied."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力先に既に同一のファイル名が存在する場合、上書きコピーされます。"
